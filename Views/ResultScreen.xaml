<Window x:Class="DestinyBall.Views.ResultScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DestinyBall.ViewModels"
        Title="Шар Судьбы — Результаты" Height="660" Width="820"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1A1A2E">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#16213E">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="🔮  ШАР СУДЬБЫ  —  РЕЗУЛЬТАТЫ" FontSize="22" FontWeight="Black"
                           Foreground="#FFD700" HorizontalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#FFD700" BlurRadius="12" ShadowDepth="0"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="Судьба определена. Пути назад нет." FontSize="12"
                           Foreground="#888" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Cards -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Player card -->
            <Border Grid.Column="0" CornerRadius="14"
                    Background="#0F3460"
                    BorderBrush="#E94560" BorderThickness="2.5">
                <Border.Effect>
                    <DropShadowEffect Color="#E94560" BlurRadius="20" ShadowDepth="0" Opacity="0.4"/>
                </Border.Effect>
                <StackPanel Margin="24,20">
                    <TextBlock Text="👤" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding PlayerName}" FontSize="20" FontWeight="Black"
                               Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="ТВОЯ СУДЬБА" FontSize="11" Foreground="#E94560"
                               HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <Separator Background="#333" Margin="0,0,0,14"/>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🏷️" FontSize="16"/>
                        <TextBlock Grid.Column="1" Text="Имя" FontSize="12" Foreground="#888" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding PlayerName2}" FontSize="14" FontWeight="Bold"
                                   Foreground="White" TextAlignment="Right" TextWrapping="Wrap"/>
                    </Grid>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🎂" FontSize="16"/>
                        <TextBlock Grid.Column="1" Text="Возраст" FontSize="12" Foreground="#888" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding PlayerAge}" FontSize="14" FontWeight="Bold"
                                   Foreground="White" TextAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="💼" FontSize="16"/>
                        <TextBlock Grid.Column="1" Text="Работа" FontSize="12" Foreground="#888" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding PlayerJob}" FontSize="13" FontWeight="Bold"
                                   Foreground="White" TextAlignment="Right" TextWrapping="Wrap"/>
                    </Grid>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🏠" FontSize="16"/>
                        <TextBlock Grid.Column="1" Text="Дом" FontSize="12" Foreground="#888" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding PlayerHouse}" FontSize="14" FontWeight="Bold"
                                   Foreground="White" TextAlignment="Right" TextWrapping="Wrap"/>
                    </Grid>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🚗" FontSize="16"/>
                        <TextBlock Grid.Column="1" Text="Машина" FontSize="12" Foreground="#888" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding PlayerCar}" FontSize="13" FontWeight="Bold"
                                   Foreground="White" TextAlignment="Right" TextWrapping="Wrap"/>
                    </Grid>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="💑" FontSize="16"/>
                        <TextBlock Grid.Column="1" Text="Муж/Жена" FontSize="12" Foreground="#888" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding PlayerPartner}" FontSize="13" FontWeight="Bold"
                                   Foreground="White" TextAlignment="Right" TextWrapping="Wrap"/>
                    </Grid>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="👶" FontSize="16"/>
                        <TextBlock Grid.Column="1" Text="Дети" FontSize="12" Foreground="#888" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding PlayerKids}" FontSize="14" FontWeight="Bold"
                                   Foreground="White" TextAlignment="Right" TextWrapping="Wrap"/>
                    </Grid>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🎮" FontSize="16"/>
                        <TextBlock Grid.Column="1" Text="Хобби" FontSize="12" Foreground="#888" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding PlayerHobby}" FontSize="13" FontWeight="Bold"
                                   Foreground="White" TextAlignment="Right" TextWrapping="Wrap"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- VS divider -->
            <TextBlock Grid.Column="1" Text="VS" VerticalAlignment="Center"
                       HorizontalAlignment="Center" FontSize="16" FontWeight="Black"
                       Foreground="#555"/>

            <!-- Bot card -->
            <Border Grid.Column="2" CornerRadius="14"
                    Background="#0F3460"
                    BorderBrush="#16D39A" BorderThickness="2.5">
                <Border.Effect>
                    <DropShadowEffect Color="#16D39A" BlurRadius="20" ShadowDepth="0" Opacity="0.4"/>
                </Border.Effect>
                <StackPanel Margin="24,20">
                    <TextBlock Text="🤖" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding BotName}" FontSize="20" FontWeight="Black"
                               Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="СУДЬБА БОТА" FontSize="11" Foreground="#16D39A"
                               HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <Separator Background="#333" Margin="0,0,0,14"/>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🏷️" FontSize="16"/>
                        <TextBlock Grid.Column="1" Text="Имя" FontSize="12" Foreground="#888" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding BotNameFate}" FontSize="14" FontWeight="Bold"
                                   Foreground="White" TextAlignment="Right" TextWrapping="Wrap"/>
                    </Grid>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🎂" FontSize="16"/>
                        <TextBlock Grid.Column="1" Text="Возраст" FontSize="12" Foreground="#888" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding BotAge}" FontSize="14" FontWeight="Bold"
                                   Foreground="White" TextAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="💼" FontSize="16"/>
                        <TextBlock Grid.Column="1" Text="Работа" FontSize="12" Foreground="#888" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding BotJob}" FontSize="13" FontWeight="Bold"
                                   Foreground="White" TextAlignment="Right" TextWrapping="Wrap"/>
                    </Grid>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🏠" FontSize="16"/>
                        <TextBlock Grid.Column="1" Text="Дом" FontSize="12" Foreground="#888" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding BotHouse}" FontSize="14" FontWeight="Bold"
                                   Foreground="White" TextAlignment="Right" TextWrapping="Wrap"/>
                    </Grid>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🚗" FontSize="16"/>
                        <TextBlock Grid.Column="1" Text="Машина" FontSize="12" Foreground="#888" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding BotCar}" FontSize="13" FontWeight="Bold"
                                   Foreground="White" TextAlignment="Right" TextWrapping="Wrap"/>
                    </Grid>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="💑" FontSize="16"/>
                        <TextBlock Grid.Column="1" Text="Муж/Жена" FontSize="12" Foreground="#888" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding BotPartner}" FontSize="13" FontWeight="Bold"
                                   Foreground="White" TextAlignment="Right" TextWrapping="Wrap"/>
                    </Grid>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="👶" FontSize="16"/>
                        <TextBlock Grid.Column="1" Text="Дети" FontSize="12" Foreground="#888" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding BotKids}" FontSize="14" FontWeight="Bold"
                                   Foreground="White" TextAlignment="Right" TextWrapping="Wrap"/>
                    </Grid>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🎮" FontSize="16"/>
                        <TextBlock Grid.Column="1" Text="Хобби" FontSize="12" Foreground="#888" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding BotHobby}" FontSize="13" FontWeight="Bold"
                                   Foreground="White" TextAlignment="Right" TextWrapping="Wrap"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer buttons -->
        <Border Grid.Row="2" Background="#16213E" Padding="20,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Button Content="{Binding CopyButtonText}"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding CopyResultsCommand}"
                        FontSize="15"
                        Padding="24,12"
                        Margin="0,0,16,0"/>
                <Button Content="🔄  Играть снова"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding PlayAgainCommand}"
                        FontSize="15"
                        Padding="24,12"
                        Background="#0F3460"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
