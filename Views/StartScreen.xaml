<Window x:Class="DestinyBall.Views.StartScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DestinyBall.ViewModels"
        Title="Шар Судьбы" Height="580" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1A1A2E">

    <Window.DataContext>
        <vm:StartScreenViewModel/>
    </Window.DataContext>

    <Grid>
        <!-- Background decoration -->
        <Canvas>
            <Ellipse Canvas.Left="-60" Canvas.Top="-60" Width="200" Height="200"
                     Fill="#0F3460" Opacity="0.5"/>
            <Ellipse Canvas.Left="320" Canvas.Top="460" Width="180" Height="180"
                     Fill="#E94560" Opacity="0.15"/>
        </Canvas>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="380">

            <!-- Title -->
            <TextBlock Text="🔮" FontSize="72" HorizontalAlignment="Center" Margin="0,0,0,8">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#E94560" BlurRadius="20" ShadowDepth="0"/>
                </TextBlock.Effect>
            </TextBlock>

            <TextBlock Text="ШАР СУДЬБЫ" FontSize="36" FontWeight="Black"
                       Foreground="White" HorizontalAlignment="Center"
                      >
                <TextBlock.Effect>
                    <DropShadowEffect Color="#E94560" BlurRadius="12" ShadowDepth="0"/>
                </TextBlock.Effect>
            </TextBlock>

            <TextBlock Text="Узнай свою судьбу!" FontSize="14"
                       Foreground="#888" HorizontalAlignment="Center"
                       Margin="0,4,0,32"/>

            <!-- Name input -->
            <TextBlock Text="КАК ТЕБЯ ЗОВУТ?" FontSize="12" FontWeight="Bold"
                       Foreground="#E94560" Margin="0,0,0,8"/>

            <TextBox Style="{StaticResource GameTextBox}"
                     Text="{Binding PlayerName, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="18"
                     Margin="0,0,0,4">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding StartGameCommand}"/>
                </TextBox.InputBindings>
            </TextBox>

            <TextBlock Text="{Binding NameError}" Foreground="#E94560"
                       FontSize="12" Margin="0,0,0,16"
                       Visibility="{Binding NameError, Converter={StaticResource StringToVisibilityConverter}}"/>

            <!-- Role selection -->
            <TextBlock Text="ВЫБЕРИ РОЛЬ" FontSize="12" FontWeight="Bold"
                       Foreground="#E94560" Margin="0,8,0,12"/>

            <Grid Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- Thrower -->
                <Border Grid.Column="0" Margin="0,0,8,0" CornerRadius="10"
                        Cursor="Hand"
                        MouseLeftButtonDown="ThrowerBorder_Click">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#0F3460"/>
                            <Setter Property="BorderBrush" Value="#0F3460"/>
                            <Setter Property="BorderThickness" Value="2"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsThrowerSelected}" Value="True">
                                    <Setter Property="Background" Value="#1a2a5e"/>
                                    <Setter Property="BorderBrush" Value="#E94560"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Margin="16,20">
                        <TextBlock Text="⚾" FontSize="36" HorizontalAlignment="Center"/>
                        <TextBlock Text="БРОСАТЕЛЬ" FontSize="14" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center"
                                   Margin="0,8,0,4"/>
                        <TextBlock Text="Ты придумываешь слова и бросаешь боту"
                                   FontSize="11" Foreground="#aaa"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Catcher -->
                <Border Grid.Column="1" Margin="8,0,0,0" CornerRadius="10"
                        Cursor="Hand"
                        MouseLeftButtonDown="CatcherBorder_Click">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#0F3460"/>
                            <Setter Property="BorderBrush" Value="#0F3460"/>
                            <Setter Property="BorderThickness" Value="2"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCatcherSelected}" Value="True">
                                    <Setter Property="Background" Value="#1a2a5e"/>
                                    <Setter Property="BorderBrush" Value="#E94560"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Margin="16,20">
                        <TextBlock Text="🥊" FontSize="36" HorizontalAlignment="Center"/>
                        <TextBlock Text="ЛОВЕЦ" FontSize="14" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center"
                                   Margin="0,8,0,4"/>
                        <TextBlock Text="Бот кидает слова — успей уклониться!"
                                   FontSize="11" Foreground="#aaa"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Button Content="🚀  НАЧАТЬ ИГРУ"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding StartGameCommand}"
                    FontSize="18"
                    Padding="0,14"
                    Margin="0,28,0,0"/>

        </StackPanel>
    </Grid>
</Window>
