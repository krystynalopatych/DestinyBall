<Window x:Class="DestinyBall.Views.GameScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Шар Судьбы — Игра" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A2E"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <!-- Storyboard for ball: player → bot (left→right) -->
        <Storyboard x:Key="ThrowToBotStoryboard" Completed="ThrowToBotStoryboard_Completed">
            <!-- X motion: 80 → 900 -->
            <DoubleAnimation Storyboard.TargetName="BallCanvas"
                             Storyboard.TargetProperty="(Canvas.Left)"
                             From="80" To="900"
                             Duration="0:0:1.4"
                             EasingFunction="{x:Null}"/>
            <!-- Y arc: 300 → 300 but dips in middle (arc via keyframes) -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BallCanvas"
                                           Storyboard.TargetProperty="(Canvas.Top)">
                <EasingDoubleKeyFrame KeyTime="0:0:0"     Value="310"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.35"  Value="180"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.7"   Value="230"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1.05"  Value="280"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1.4"   Value="310"/>
            </DoubleAnimationUsingKeyFrames>
            <!-- Scale during flight -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BallScale"
                                           Storyboard.TargetProperty="ScaleX">
                <EasingDoubleKeyFrame KeyTime="0:0:0"    Value="1.0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.7"  Value="1.3"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1.4"  Value="0.8"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BallScale"
                                           Storyboard.TargetProperty="ScaleY">
                <EasingDoubleKeyFrame KeyTime="0:0:0"    Value="1.0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.7"  Value="1.3"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1.4"  Value="0.8"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- Storyboard for ball: bot → player (right→left) -->
        <Storyboard x:Key="ThrowToPlayerStoryboard" Completed="ThrowToPlayerStoryboard_Completed">
            <DoubleAnimation Storyboard.TargetName="BallCanvas"
                             Storyboard.TargetProperty="(Canvas.Left)"
                             From="900" To="80"
                             Duration="0:0:1.5"/>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BallCanvas"
                                           Storyboard.TargetProperty="(Canvas.Top)">
                <EasingDoubleKeyFrame KeyTime="0:0:0"     Value="310"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.375" Value="160"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.75"  Value="210"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1.125" Value="270"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1.5"   Value="310"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BallScale"
                                           Storyboard.TargetProperty="ScaleX">
                <EasingDoubleKeyFrame KeyTime="0:0:0"     Value="0.8"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.75"  Value="1.4"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1.5"   Value="1.1"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BallScale"
                                           Storyboard.TargetProperty="ScaleY">
                <EasingDoubleKeyFrame KeyTime="0:0:0"     Value="0.8"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.75"  Value="1.4"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1.5"   Value="1.1"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- Rotation storyboard for spinning ball -->
        <Storyboard x:Key="SpinBallStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="BallRotation"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360"
                             Duration="0:0:0.8"/>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>   <!-- header -->
            <RowDefinition Height="*"/>    <!-- main -->
            <RowDefinition Height="80"/>   <!-- controls -->
        </Grid.RowDefinitions>

        <!-- ── HEADER ── -->
        <Border Grid.Row="0" Background="#16213E">
            <Grid Margin="20,0">
                <TextBlock Text="🔮 ШАР СУДЬБЫ" VerticalAlignment="Center"
                           FontSize="20" FontWeight="Black" Foreground="White"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="КАТЕГОРИЯ: " FontSize="13" Foreground="#888"/>
                    <TextBlock Text="{Binding CurrentCategoryDisplay}"
                               FontSize="17" FontWeight="Bold" Foreground="#FFD700"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── MAIN GAME AREA ── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>  <!-- player card -->
                <ColumnDefinition Width="*"/>    <!-- arena -->
                <ColumnDefinition Width="220"/>  <!-- bot card -->
            </Grid.ColumnDefinitions>

            <!-- Player destiny card -->
            <Border Grid.Column="0" Margin="10" CornerRadius="12"
                    Background="#0F3460" BorderBrush="#E94560" BorderThickness="2">
                <StackPanel Margin="12">
                    <TextBlock Text="{Binding PlayerName, StringFormat='👤 {0}'}"
                               FontSize="14" FontWeight="Bold" Foreground="White"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="СУДЬБА:" FontSize="10" Foreground="#E94560"
                               Margin="0,0,0,6"/>
                    <ItemsControl>
                        <ItemsControl.Items>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="🏷️ " FontSize="12"/>
                                <TextBlock Text="{Binding DestName}" FontSize="12"
                                           Foreground="#eee" TextWrapping="Wrap" MaxWidth="150"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="🎂 " FontSize="12"/>
                                <TextBlock Text="{Binding DestAge}" FontSize="12" Foreground="#eee"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="💼 " FontSize="12"/>
                                <TextBlock Text="{Binding DestJob}" FontSize="12"
                                           Foreground="#eee" TextWrapping="Wrap" MaxWidth="150"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="🏠 " FontSize="12"/>
                                <TextBlock Text="{Binding DestHouse}" FontSize="12"
                                           Foreground="#eee" TextWrapping="Wrap" MaxWidth="150"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="🚗 " FontSize="12"/>
                                <TextBlock Text="{Binding DestCar}" FontSize="12"
                                           Foreground="#eee" TextWrapping="Wrap" MaxWidth="150"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="💑 " FontSize="12"/>
                                <TextBlock Text="{Binding DestPartner}" FontSize="12"
                                           Foreground="#eee" TextWrapping="Wrap" MaxWidth="150"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="👶 " FontSize="12"/>
                                <TextBlock Text="{Binding DestKids}" FontSize="12"
                                           Foreground="#eee" TextWrapping="Wrap" MaxWidth="150"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="🎮 " FontSize="12"/>
                                <TextBlock Text="{Binding DestHobby}" FontSize="12"
                                           Foreground="#eee" TextWrapping="Wrap" MaxWidth="150"/>
                            </StackPanel>
                        </ItemsControl.Items>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ── ARENA ── -->
            <Grid Grid.Column="1">
                <!-- Status message -->
                <TextBlock Text="{Binding StatusMessage}"
                           HorizontalAlignment="Center" VerticalAlignment="Top"
                           Margin="0,14,0,0"
                           FontSize="15" Foreground="#eee"
                           TextWrapping="Wrap" TextAlignment="Center"
                           MaxWidth="580"/>

                <!-- Timer bar (visible only in catcher mode during flight) -->
                <Border VerticalAlignment="Top" HorizontalAlignment="Center"
                        Margin="0,44,0,0"
                        Width="500" Height="14"
                        CornerRadius="7"
                        Background="#333">
                    <Border.Visibility>
                        <Binding Path="IsCatcherMode" Converter="{StaticResource BoolToVisibilityConverter}"/>
                    </Border.Visibility>
                    <Grid>
                        <Border x:Name="TimerBarFill" CornerRadius="7"
                                HorizontalAlignment="Left">
                            <Border.Width>
                                <Binding Path="TimerProgress" Converter="{StaticResource ProgressToWidthConverter}"
                                         ConverterParameter="500"/>
                            </Border.Width>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00ff88" Offset="0"/>
                                    <GradientStop Color="#ffcc00" Offset="0.5"/>
                                    <GradientStop Color="#E94560" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>
                </Border>

                <!-- Ball arena canvas -->
                <Canvas x:Name="ArenaCanvas" Margin="0,65,0,0">

                    <!-- Ground line -->
                    <Line X1="0" Y1="350" X2="700" Y2="350"
                          Stroke="#333" StrokeThickness="1" StrokeDashArray="4,4"/>

                    <!-- Player figure (left) -->
                    <StackPanel Canvas.Left="20" Canvas.Top="260">
                        <TextBlock Text="🙋" FontSize="48" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding PlayerName}" FontSize="11"
                                   Foreground="#aaa" HorizontalAlignment="Center"
                                   MaxWidth="100" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>

                    <!-- Bot figure (right) -->
                    <StackPanel Canvas.Left="600" Canvas.Top="255">
                        <TextBlock Text="{Binding BotFaceEmoji}" FontSize="52"
                                   HorizontalAlignment="Center">
                            <TextBlock.RenderTransformOrigin>0.5,0.5</TextBlock.RenderTransformOrigin>
                        </TextBlock>
                        <TextBlock Text="{Binding BotFaceMessage}" FontSize="10"
                                   Foreground="#FFD700" HorizontalAlignment="Center"
                                   MaxWidth="100" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>

                    <!-- THE BALL -->
                    <Canvas x:Name="BallCanvas" Canvas.Left="80" Canvas.Top="310">
                        <Canvas.RenderTransformOrigin>0.5,0.5</Canvas.RenderTransformOrigin>
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="BallScale" ScaleX="1" ScaleY="1"/>
                                <RotateTransform x:Name="BallRotation" CenterX="30" CenterY="30"/>
                            </TransformGroup>
                        </Canvas.RenderTransform>

                        <!-- Ball glow -->
                        <Ellipse Width="60" Height="60" Canvas.Left="0" Canvas.Top="0">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#FFD700" Offset="0"/>
                                    <GradientStop Color="#FF8C00" Offset="0.6"/>
                                    <GradientStop Color="#CC4400" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#FFD700" BlurRadius="16"
                                                  ShadowDepth="0" Opacity="0.8"/>
                            </Ellipse.Effect>
                        </Ellipse>

                        <!-- Ball seam lines -->
                        <Path Stroke="#CC4400" StrokeThickness="2" IsHitTestVisible="False">
                            <Path.Data>
                                <PathGeometry>
                                    <PathFigure StartPoint="15,10">
                                        <BezierSegment Point1="30,5" Point2="30,55" Point3="45,50"/>
                                    </PathFigure>
                                </PathGeometry>
                            </Path.Data>
                        </Path>
                        <Path Stroke="#CC4400" StrokeThickness="2" IsHitTestVisible="False">
                            <Path.Data>
                                <PathGeometry>
                                    <PathFigure StartPoint="15,50">
                                        <BezierSegment Point1="30,55" Point2="30,5" Point3="45,10"/>
                                    </PathFigure>
                                </PathGeometry>
                            </Path.Data>
                        </Path>
                    </Canvas>

                    <!-- Flying word label -->
                    <Border x:Name="WordBubble" Canvas.Left="200" Canvas.Top="120"
                            CornerRadius="10"
                            Padding="14,8"
                            Visibility="{Binding IsWordVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#E94560" Offset="0"/>
                                <GradientStop Color="#C0002A" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="#E94560" BlurRadius="18"
                                              ShadowDepth="0" Opacity="0.9"/>
                        </Border.Effect>
                        <TextBlock Text="{Binding FlightWord}"
                                   FontSize="22" FontWeight="Black"
                                   Foreground="White"/>
                    </Border>
                </Canvas>
            </Grid>

            <!-- Bot destiny card -->
            <Border Grid.Column="2" Margin="10" CornerRadius="12"
                    Background="#0F3460" BorderBrush="#16D39A" BorderThickness="2">
                <StackPanel Margin="12">
                    <TextBlock Text="🤖 Бот Судьбыч"
                               FontSize="14" FontWeight="Bold" Foreground="White"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="СУДЬБА:" FontSize="10" Foreground="#16D39A"
                               Margin="0,0,0,6"/>
                    <ItemsControl>
                        <ItemsControl.Items>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="🏷️ " FontSize="12"/>
                                <TextBlock Text="{Binding BotDestName}" FontSize="12"
                                           Foreground="#eee" TextWrapping="Wrap" MaxWidth="150"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="🎂 " FontSize="12"/>
                                <TextBlock Text="{Binding BotDestAge}" FontSize="12" Foreground="#eee"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="💼 " FontSize="12"/>
                                <TextBlock Text="{Binding BotDestJob}" FontSize="12"
                                           Foreground="#eee" TextWrapping="Wrap" MaxWidth="150"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="🏠 " FontSize="12"/>
                                <TextBlock Text="{Binding BotDestHouse}" FontSize="12"
                                           Foreground="#eee" TextWrapping="Wrap" MaxWidth="150"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="🚗 " FontSize="12"/>
                                <TextBlock Text="{Binding BotDestCar}" FontSize="12"
                                           Foreground="#eee" TextWrapping="Wrap" MaxWidth="150"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="💑 " FontSize="12"/>
                                <TextBlock Text="{Binding BotDestPartner}" FontSize="12"
                                           Foreground="#eee" TextWrapping="Wrap" MaxWidth="150"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="👶 " FontSize="12"/>
                                <TextBlock Text="{Binding BotDestKids}" FontSize="12"
                                           Foreground="#eee" TextWrapping="Wrap" MaxWidth="150"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="🎮 " FontSize="12"/>
                                <TextBlock Text="{Binding BotDestHobby}" FontSize="12"
                                           Foreground="#eee" TextWrapping="Wrap" MaxWidth="150"/>
                            </StackPanel>
                        </ItemsControl.Items>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ── CONTROLS ── -->
        <Border Grid.Row="2" Background="#16213E" Padding="16,0">
            <Grid>
                <!-- Thrower controls -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsThrowerMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBox Style="{StaticResource GameTextBox}"
                             Text="{Binding ThrowWordInput, UpdateSourceTrigger=PropertyChanged}"
                             Width="320" FontSize="16"
                             IsEnabled="{Binding CanThrow}"
                             x:Name="ThrowInput">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding ThrowCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Content="⚾  БРОСИТЬ"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding ThrowCommand}"
                            IsEnabled="{Binding CanThrow}"
                            Margin="12,0,0,0"
                            FontSize="16"
                            Padding="20,10"/>
                </StackPanel>

                <!-- Catcher hint -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsCatcherMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border Background="#1a1a3a" CornerRadius="8" Padding="20,10">
                        <TextBlock Foreground="#888" FontSize="14">
                            <Run Text="🖱️  Нажми "/>
                            <Run Text="ЛЮБУЮ КНОПКУ МЫШИ" FontWeight="Bold" Foreground="#E94560"/>
                            <Run Text=" чтобы уклониться от мяча!"/>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- GAME OVER OVERLAY -->
        <Grid Grid.RowSpan="3"
              Visibility="{Binding IsGameOver, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.Background>
                <SolidColorBrush Color="Black" Opacity="0.7"/>
            </Grid.Background>
            <Border Background="#1A1A2E" CornerRadius="16"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="40,30" MinWidth="380"
                    BorderBrush="#E94560" BorderThickness="2">
                <StackPanel>
                    <TextBlock Text="🎉 СУДЬБА РЕШЕНА! 🎉"
                               FontSize="26" FontWeight="Black"
                               Foreground="#FFD700" HorizontalAlignment="Center"
                               Margin="0,0,0,16"/>
                    <TextBlock Text="Игра завершена! Проверь свои карточки судьбы."
                               FontSize="14" Foreground="#aaa"
                               HorizontalAlignment="Center" Margin="0,0,0,24"/>
                    <Button Content="📊  ПОСМОТРЕТЬ РЕЗУЛЬТАТЫ"
                            Style="{StaticResource PrimaryButton}"
                            Click="ShowResults_Click"
                            FontSize="16"
                            Padding="0,14"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
